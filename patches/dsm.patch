+        # sigma(t)^2 = sigma_min^2 + 4 (sigma_mid^2 - sigma_min^2) t (1 - t)
+        return jnp.sqrt(
+            self.sigma_min**2
+            + 4 * (self.sigma_mid**2 - self.sigma_min**2) * t * (1 - t)
