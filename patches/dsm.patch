+    def loss_fn_dsm(self, params, batch_pair, key):
+        # x~_t = I(x0, x1, t) + sigma_t z (mod 1);  rho~_t = rho_t * N(0, sigma_t^2)
+        # conditional score of rho~_t is -z/sigma_t, so the DSM target for grad U_t is z/sigma_t;
+        # sigma_t^2-weighted objective: || sigma_t grad_x U_t(x~_t) - z ||^2.
+        # dU/dt is evaluated at the same noised points (rolling TI estimate along rho~_t).
+        # Wrapped-Gaussian corrections are neglected (valid for sigma_t << 1 box length).
+        batch0, batch1 = batch_pair
+        key_t, key_z = jax.random.split(key)
+        t = jax.random.uniform(key_t, (len(batch0), 1))
+        z = jax.random.normal(key_z, batch0.shape)
+
+        def loss_one(x0, x1, t, z):
+            dx = ((x1 - x0) + 0.5) % 1 - 0.5
+            xt = x0 + t[0] * dx
+            s = self.sigma(t[0])
+            xt = (xt + s * z) % 1
+            U, (dUdx, dUdt) = jax.value_and_grad(partial(self.U, params), (0, 1))(xt, t)
+            score_loss = (s * dUdx - z) ** 2
+            return score_loss.mean(), dUdt
+
+        L_score, dudt = jax.vmap(loss_one)(batch0, batch1, t, z)
+        dudt_loss = dudt**2
+        loss = (
+            self.loss_x_weight(t.reshape(-1)) * L_score
         ).mean() + self.loss_t_weight * (dudt_loss).mean()
         aux = (L_score.mean(), dudt_loss.mean(), dudt.mean())
